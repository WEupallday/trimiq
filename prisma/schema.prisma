// TrimIQ database schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  username             String?   @unique
  tiktokUsername       String?
  passwordHash         String
  plan                 String    @default("free")
  editsUsed            Int       @default(0)
  isAdmin              Boolean   @default(false)
  isCreatorBeta        Boolean   @default(false)
  isTestAccount        Boolean   @default(false)
  suspended            Boolean   @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
}

model ProcessingJob {
  id         String   @id @default(cuid())
  email      String
  name       String
  status      String // "done" | "error"
  durationMs  Int      @default(0)
  error       String?
  creatorBeta Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  email     String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ---- Product analytics (self-hosted; one row per event) ----
model Event {
  id     String   @id @default(cuid())
  ts     DateTime @default(now())
  name   String
  email  String?
  anonId String?
  props  Json?

  @@index([name, ts])
  @@index([email, ts])
}

// ---- Editing-engine benchmark results (eval harness, keyed by engine version) ----
model BenchmarkRun {
  id            String   @id @default(cuid())
  ts            DateTime @default(now())
  engineVersion String
  label         String
  clipName      String
  clipHash      String
  mode          String
  model         String
  metrics       Json

  @@index([clipHash, ts])
  @@index([engineVersion, ts])
}

// Persistent processing queue: job status/history survive server restarts and
// browser closes. Media files live on ephemeral disk; jobs whose files were
// wiped by a deploy are marked failed on boot (no credit charged).
model QueueJob {
  id            String    @id
  email         String
  batchId       String    @default("")
  name          String
  status        String    @default("queued") // queued | processing | done | error
  stage         String    @default("Queued")
  error         String?
  mode          String?
  paid          Boolean   @default(false)
  priority      Int       @default(0)
  stats         Json?
  applied       Json?
  acked         Boolean   @default(false) // batch-completion notification acknowledged
  creditCharged Boolean   @default(false)
  createdAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@index([email, createdAt])
  @@index([status])
}

// In-app support: messages that the rule-based helper couldn’t answer.
// Stored here and pushed to Discord via DISCORD_WEBHOOK_URL (notify.ts).
model SupportTicket {
  id        String   @id @default(cuid())
  email     String?
  message   String
  page      String?
  status    String   @default("open") // open | closed
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}
