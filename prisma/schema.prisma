// TrimIQ database schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  username             String?   @unique
  tiktokUsername       String?
  passwordHash         String
  plan                 String    @default("free")
  editsUsed            Int       @default(0)
  isAdmin              Boolean   @default(false)
  isCreatorBeta        Boolean   @default(false)
  isTestAccount        Boolean   @default(false)
  suspended            Boolean   @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
}

model ProcessingJob {
  id         String   @id @default(cuid())
  email      String
  name       String
  status      String // "done" | "error"
  durationMs  Int      @default(0)
  error       String?
  creatorBeta Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  email     String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ---- Product analytics (self-hosted; one row per event) ----
model Event {
  id     String   @id @default(cuid())
  ts     DateTime @default(now())
  name   String
  email  String?
  anonId String?
  props  Json?

  @@index([name, ts])
  @@index([email, ts])
}

// ---- Editing-engine benchmark results (eval harness, keyed by engine version) ----
model BenchmarkRun {
  id            String   @id @default(cuid())
  ts            DateTime @default(now())
  engineVersion String
  label         String
  clipName      String
  clipHash      String
  mode          String
  model         String
  metrics       Json

  @@index([clipHash, ts])
  @@index([engineVersion, ts])
}
