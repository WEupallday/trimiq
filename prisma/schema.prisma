// TrimIQ database schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  username             String?   @unique
  tiktokUsername       String?
  passwordHash         String
  plan                 String    @default("free")
  editsUsed            Int       @default(0)
  isAdmin              Boolean   @default(false)
  isCreatorBeta        Boolean   @default(false)
  isTestAccount        Boolean   @default(false)
  suspended            Boolean   @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
}

model ProcessingJob {
  id         String   @id @default(cuid())
  email      String
  name       String
  status      String // "done" | "error"
  durationMs  Int      @default(0)
  error       String?
  creatorBeta Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  email     String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ---------- Viral Product Intelligence (Discover) ----------
// A tracked TikTok Shop product. Score/velocity/gmv fields are computed per
// window (7/30/90d) from the append-only ProductSnapshot series.
model ShopProduct {
  id              String   @id @default(cuid())
  tiktokProductId String   @unique
  title           String
  imageUrl        String?
  productUrl      String?
  sellerName      String?
  category        String   // beauty | home | fitness
  region          String   @default("US")
  currency        String   @default("USD")
  // latest observed
  latestPrice     Float    @default(0)
  latestSoldCount Int      @default(0)
  // per-window derived metrics
  trend7          Int      @default(0)
  trend30         Int      @default(0)
  trend90         Int      @default(0)
  momentum7       Int      @default(0)
  vel7            Float    @default(0) // units/day
  vel30           Float    @default(0)
  gmv7            Float    @default(0)
  gmv30           Float    @default(0)
  gmv90           Float    @default(0)
  growth7         Float    @default(0)
  state           String   @default("stable") // breakout|rising|stable|cooling
  isBreakout      Boolean  @default(false)
  creatorSpread   Int      @default(0)
  confidence      Float    @default(1)
  firstSeenAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([region, category, trend7])
  @@index([region, category, trend30])
}

model ProductSnapshot {
  id         String   @id @default(cuid())
  productId  String
  capturedAt DateTime @default(now())
  price      Float
  soldLo     Int
  confidence Float    @default(1)

  @@index([productId, capturedAt])
}


// ---- Product analytics (self-hosted; one row per event) ----
model Event {
  id     String   @id @default(cuid())
  ts     DateTime @default(now())
  name   String
  email  String?
  anonId String?
  props  Json?

  @@index([name, ts])
  @@index([email, ts])
}

// ---- Editing-engine benchmark results (eval harness, keyed by engine version) ----
model BenchmarkRun {
  id            String   @id @default(cuid())
  ts            DateTime @default(now())
  engineVersion String
  label         String
  clipName      String
  clipHash      String
  mode          String
  model         String
  metrics       Json

  @@index([clipHash, ts])
  @@index([engineVersion, ts])
}
